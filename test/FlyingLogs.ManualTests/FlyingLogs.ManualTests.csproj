<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>

    <RestorePackagesPath>$(BaseIntermediateOutputPath)PackageCache/</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
    <None Include="Generated\FlyingLogs.Analyzers\FlyingLogs.Analyzers.FlyingLogsSourceGenerator\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package is generated locally via 'dotnet pack'. Allow any version, including the previews. -->
    <PackageReference Include="FlyingLogs" Version="*-*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlyingLogs.Sinks.Seq\FlyingLogs.Sinks.Seq.csproj" />
  </ItemGroup>

  <Target Name="CleanNugetCache" BeforeTargets="Clean">
    <RemoveDir Directories="$(RestorePackagesPath)flyinglogs;$(RestorePackagesPath)flyinglogs.core" />
  </Target>
</Project>
